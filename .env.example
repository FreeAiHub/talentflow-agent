# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here  # Fallback

# Parsing and Integration
DJINNI_API_KEY=your_djinni_key_if_needed
LINKEDIN_COOKIE=your_linkedin_session_cookie  # For JobSpy or similar

# Database and Storage
DATABASE_URL=postgresql://user:pass@localhost/talentflow
AIRTABLE_API_KEY=your_airtable_key
REDIS_URL=redis://localhost:6379

# External Services
CALENDLY_API_KEY=your_calendly_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Application Config
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_PARALLEL_REQUESTS=10