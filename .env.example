# TalentFlow Agent — переменные окружения.
#
# Скопируйте в .env и заполните значения. Файл .env в git не попадает (см. .gitignore).
# Читается только то, что объявлено в src/talentflow/config.py (Settings):
# все имена — с префиксом TALENTFLOW_, остальные переменные игнорируются.

# ─── База данных ───────────────────────────────────────────────────────────
# Локально по умолчанию SQLite. В docker-compose URL подставляется сам и
# указывает на сервис db; драйвер asyncpg приложение подставляет само.
TALENTFLOW_DATABASE_URL=sqlite:///./talentflow.db

# Учётные данные PostgreSQL — только для docker-compose.
POSTGRES_USER=talentflow
POSTGRES_PASSWORD=
POSTGRES_DB=talentflow

# ─── LLM ───────────────────────────────────────────────────────────────────
# Нужен ХОТЯ БЫ ОДИН ключ. Порядок обращения задаётся префиксом у модели:
# "provider:model", провайдеры — openrouter, groq, cerebras.
#
# Внимание: бесплатный тариф OpenRouter даёт всего 50 запросов в сутки, а
# конвейеру нужно ~250. Поэтому основным разумно делать Groq или Cerebras,
# а OpenRouter держать для сравнения моделей.
TALENTFLOW_OPENROUTER_API_KEY=
TALENTFLOW_GROQ_API_KEY=
TALENTFLOW_CEREBRAS_API_KEY=

# Основная модель, затем резервные — через запятую, в порядке обращения.
TALENTFLOW_LLM_MODELS=openrouter:openai/gpt-oss-120b:free
TALENTFLOW_LLM_FALLBACK_MODELS=groq:llama-3.3-70b-versatile

# Потолок вызовов в сутки (UTC). Достигнув его, скоринг останавливается,
# а не выжигает лимиты провайдера.
TALENTFLOW_LLM_DAILY_CALL_LIMIT=250
TALENTFLOW_LLM_TIMEOUT_SECONDS=60
TALENTFLOW_LLM_MAX_ATTEMPTS=3
TALENTFLOW_LLM_TEMPERATURE=0.2
TALENTFLOW_LLM_MAX_TOKENS=2000

# Профиль идеального клиента — по нему скоринг решает, стоит ли брать вакансию.
# ВНИМАНИЕ: значение ниже — заготовка. Замените на реальный ICP, иначе оценки
# не будут иметь коммерческого смысла.
# TALENTFLOW_ICP_PROFILE=

# ─── Аутрич ────────────────────────────────────────────────────────────────
# От чьего имени пишем. Генератору запрещено выдумывать достижения, поэтому
# всё, чего нет здесь, просто не попадёт в письмо. Значение по умолчанию —
# заготовка с пометкой [ЗАПОЛНИТЬ].
# TALENTFLOW_SENDER_PROFILE=
TALENTFLOW_CTA=Reply with a time that suits you.

# Проверка черновика на выдуманные факты: второй вызов LLM на каждое письмо.
# Выключение экономит вызов ценой риска отправить клиенту придуманный факт.
TALENTFLOW_GROUNDING_CHECK_ENABLED=true
TALENTFLOW_GROUNDING_REJECT_IS_FATAL=true

# ─── Конвейер ──────────────────────────────────────────────────────────────
# Выключен по умолчанию намеренно: случайно запущенный uvicorn не должен
# начинать ходить на Djinni и тратить вызовы LLM. На деплое включить.
TALENTFLOW_SCHEDULER_ENABLED=false
TALENTFLOW_SCHEDULER_INTERVAL_MINUTES=30

# Потолки на один прогон, чтобы один проход не съел весь бюджет.
TALENTFLOW_PIPELINE_PARSE_LIMIT=50
TALENTFLOW_PIPELINE_SCORE_LIMIT=50
# 0 — генерация писем не входит в автоматический прогон.
TALENTFLOW_PIPELINE_GENERATE_LIMIT=0

# Порог, выше которого вакансия считается стоящей.
TALENTFLOW_MIN_LEAD_SCORE=0.6

# ─── Уведомления в Telegram ────────────────────────────────────────────────
# Без токена и chat_id уведомления просто не отправляются, а стадия notify в
# конвейере помечается skipped с причиной.
# TALENTFLOW_TELEGRAM_BOT_TOKEN=
# TALENTFLOW_TELEGRAM_CHAT_ID=

# Секрет, который Telegram присылает в заголовке X-Telegram-Bot-Api-Secret-Token.
# Без него вебхук отказывает: иначе любой POST мог бы утверждать черновики.
# TALENTFLOW_TELEGRAM_WEBHOOK_SECRET=

# Потолок исходящих сообщений в минуту.
TALENTFLOW_TELEGRAM_MAX_MESSAGES_PER_MINUTE=20

# ─── Наблюдаемость (необязательно) ─────────────────────────────────────────
# Трассировка включается, только если заданы оба ключа И установлен
# langfuse: uv sync --extra observability
# TALENTFLOW_LANGFUSE_PUBLIC_KEY=
# TALENTFLOW_LANGFUSE_SECRET_KEY=
# TALENTFLOW_LANGFUSE_HOST=http://localhost:3000

# ─── Прочее ────────────────────────────────────────────────────────────────
# Голосовые звонки (Vapi)
TALENTFLOW_VAPI_API_KEY=

# Секрет вебхука Vapi. Приходит в заголовке X-Vapi-Signature — это общий
# токен, а не HMAC по телу. Без него /webhooks/vapi отвечает 503.
# TALENTFLOW_VAPI_WEBHOOK_SECRET=

# Отклик отправляется только после подтверждения человеком (true/false)
TALENTFLOW_HUMAN_IN_THE_LOOP=true

# ---------------------------------------------------------------------------
# Планируется (ещё НЕ читается приложением — поля появятся в Settings вместе
# с соответствующими интеграциями; раскомментировать сейчас бессмысленно):
#
# TALENTFLOW_TELEGRAM_BOT_TOKEN=
# TALENTFLOW_TELEGRAM_CHAT_ID=
# TALENTFLOW_CALENDLY_API_KEY=
# TALENTFLOW_AIRTABLE_API_KEY=
# TALENTFLOW_LOG_LEVEL=
# TALENTFLOW_ENVIRONMENT=
